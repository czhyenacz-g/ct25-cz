# Veřejný kontaktní e-mail zobrazený na stránce /kontakt.
# Pokud není nastaven, produkce nezobrazí žádný kontakt (viz docs/LEGAL-TODO.md).
NEXT_PUBLIC_CONTACT_EMAIL=

# GoatCounter subdoména pro analytiku (volitelné). Skript se načte
# jen tehdy, když návštěvník udělí souhlas s analytickými cookies.
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Google AdSense client ID (např. "ca-pub-XXXXXXXXXXXXXXXX"). Po souhlasu
# s marketingovými cookies načte jen ověřovací account script (propojení
# účtu) – žádné reklamní jednotky, viz app/components/ads/AdSenseAccountScript.tsx.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# "true" = AdSlot začne vykreslovat skutečné reklamní jednotky namísto
# vývojového placeholderu/ničeho. Nezávislé na CLIENT_ID výše – nech na
# false, dokud nebudou existovat konkrétní slot ID pro jednotlivé pozice.
NEXT_PUBLIC_ADSENSE_ADS_ENABLED=false
